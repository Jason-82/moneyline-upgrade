{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Rr][Oo][Bb][Ii][Nn][Hh][Oo][Oo][Dd].*",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"${AGENTIC_PYTHON:-python3}\" -I \"${CLAUDE_PROJECT_DIR}/agentic/hooks/pre_tool_use.py\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*[Rr][Oo][Bb][Ii][Nn][Hh][Oo][Oo][Dd].*",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"${AGENTIC_PYTHON:-python3}\" -I \"${CLAUDE_PROJECT_DIR}/agentic/hooks/post_tool_use.py\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*[Rr][Oo][Bb][Ii][Nn][Hh][Oo][Oo][Dd].*",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"${AGENTIC_PYTHON:-python3}\" -I \"${CLAUDE_PROJECT_DIR}/agentic/hooks/post_tool_use.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__robinhood-trading__place_option_order",
      "mcp__robinhood-trading__review_option_order",
      "mcp__robinhood-trading__cancel_option_order",
